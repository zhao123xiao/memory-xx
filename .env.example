# Memory XX Wrapper Configuration

# Server
MEMORY_V2_WRAPPER_PORT=5100
MEMORY_V2_WRAPPER_MODE=recall-only

# PostgreSQL
MEMORY_V2_DATABASE_URL=postgres://user:pass@localhost:5432/memory_xx
MEMORY_V2_DATABASE_SCHEMA=public
MEMORY_V2_DATABASE_MAX_CONNECTIONS=10
MEMORY_V2_DATABASE_IDLE_TIMEOUT_MS=30000

# Redis
MEMORY_V2_REDIS_URL=redis://localhost:6379/0
MEMORY_V2_CACHE_TTL_SECONDS=300
MEMORY_V2_CACHE_KEY_PREFIX=memory_xx

# Capacity audit thresholds
MEMORY_V2_CAPACITY_MEMORY_RECORDS_THRESHOLD=100000
MEMORY_V2_CAPACITY_OUTBOX_PENDING_THRESHOLD=1000
MEMORY_V2_CAPACITY_WRITE_TICKETS_ACTIVE_THRESHOLD=5000
MEMORY_V2_CAPACITY_QDRANT_POINTS_THRESHOLD=50000
MEMORY_V2_CAPACITY_REDIS_USED_MEMORY_RATIO_THRESHOLD=0.8
MEMORY_V2_CAPACITY_REDIS_CACHE_KEYS_THRESHOLD=10000
MEMORY_V2_CAPACITY_OUTBOX_DEAD_LETTER_THRESHOLD=50
MEMORY_V2_CAPACITY_OUTBOX_DEAD_LETTER_MAX_ATTEMPTS=5

# Qdrant (optional)
MEMORY_V2_QDRANT_BASE_URL=http://localhost:6333
MEMORY_V2_QDRANT_COLLECTION=memory-xx

# OpenAI / Embeddings
OPENAI_API_KEY=<set-in-env>
EMBEDDING_API_BASE=https://api.scnet.cn/api/llm/v1
EMBEDDING_API_KEY=<set-in-env>

# Intelligence / mem0 extractor
MEMORY_INTELLIGENCE_API_KEY=<set-in-env>
MEMORY_INTELLIGENCE_FALLBACK_API_KEY=<set-in-env>
MEMORY_INTELLIGENCE_MEM0_API_KEY=<set-in-env>
MEMORY_INTELLIGENCE_MEM0_URL=http://127.0.0.1:5220

# Security
MEMORY_V2_API_TOKEN=<set-in-env>
MEMORY_V2_MCP_TOKEN=<set-in-env>
MEMORY_V2_ADMIN_TOKEN=<set-in-env>

# CORS
MEMORY_V2_CORS_ENABLED=true
MEMORY_V2_CORS_ORIGINS=

# Rate Limiting
MEMORY_V2_RATE_LIMIT_MAX=60
MEMORY_V2_RATE_LIMIT_WINDOW_MS=60000

# Logging
MEMORY_V2_LOG_LEVEL=info
