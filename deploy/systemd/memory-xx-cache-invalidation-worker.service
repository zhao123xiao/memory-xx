[Unit]
Description=memory-xx cache invalidation worker
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=<project-root>
EnvironmentFile=-<project-root>/.env
Environment=MEMORY_XX_ENV_PATH=<project-root>/.env
Environment=TMPDIR=/tmp
ExecCondition=/usr/bin/node --import tsx scripts/runtime-module-enabled.ts cache_invalidation_worker
ExecStart=/usr/bin/node --import tsx <project-root>/scripts/run-cache-invalidation-worker.ts
Nice=5
