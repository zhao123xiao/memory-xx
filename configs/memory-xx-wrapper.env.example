# Local env file for the memory-xx wrapper systemd user service.
# Copy to ~/.config/openclaw/memory-xx-wrapper.env and fill real values.

MEMORY_XX_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/memory_xx
MEMORY_XX_DATABASE_SCHEMA=memory_xx
MEMORY_XX_WRAPPER_PORT=5100
# Overall operating profile. Core keeps vector recall online but treats
# fastpath/lexical-sidecar/reranker/graph as optional enhancements.
MEMORY_XX_RUNTIME_PROFILE=core
# Wrapper-internal compatibility mode; do not use this as the overall runtime
# profile selector.
MEMORY_XX_WRAPPER_MODE=full
MEMORY_XX_INSTANCE_COUNT=1
# `local` is valid for the default single-wrapper deployment. Set `redis` only
# after Redis is available and release-ready is expected to allow multiple
# wrapper instances.
MEMORY_XX_SEMANTIC_LOCK_BACKEND=local
MEMORY_XX_SCOPE_POLICY_MODE=strict
MEMORY_XX_FASTPATH_PRIMARY_TIMEOUT_CAP_MS=3000
MEMORY_XX_QUERY_EMBEDDING_TIMEOUT_MS=5000
MEMORY_XX_QUERY_EMBEDDING_MAX_RETRIES=0
MEMORY_XX_NODE_VECTOR_SUPPLEMENT_TIMEOUT_MS=1200
MEMORY_XX_NODE_GRAPH_SUPPLEMENT_TIMEOUT_MS=800
MEMORY_XX_QDRANT_VERIFY_TIMEOUT_MS=1200
MEMORY_XX_QDRANT_VERIFY_RETRIES=2
MEMORY_XX_DECAY_ARCHIVE_THRESHOLD=0.30
MEMORY_XX_DECAY_HIDE_THRESHOLD=0.10
MEMORY_XX_EPISODE_WINDOW_HOURS=24
# Memory Redis must be an external Docker-managed Redis, not relay redis.
# Example: redis://127.0.0.1:56379/0 or redis://memory-redis:6379/0
# MEMORY_XX_REDIS_URL=redis://127.0.0.1:6379/0
MEMORY_XX_REDIS_PREFIX=memory-xx-local-qwen8b-int4
MEMORY_XX_REDIS_CONNECT_TIMEOUT_MS=2000
MEMORY_XX_REDIS_TTL_SEARCH_SECONDS=300
MEMORY_XX_REDIS_TTL_SESSION_SECONDS=1800
MEMORY_XX_REDIS_TTL_RECENT_SECONDS=900
MEMORY_XX_REDIS_TTL_STARTUP_CONTEXT_SECONDS=600
MEMORY_XX_OUTBOX_EVENT_RETENTION_DAYS=90
MEMORY_XX_MEMORY_EVENT_RETENTION_DAYS=180
MEMORY_XX_EVENT_OUTBOX_PENDING_BLOCKER_THRESHOLD=1000
MEMORY_XX_EVENT_OUTBOX_DEAD_LETTER_BLOCKER_THRESHOLD=0
MEMORY_XX_EVENT_ROWS_WARNING_THRESHOLD=100000
# Optional Feishu/generic webhook for Doctor/capacity/degradation alerts.
# MEMORY_XX_ALERT_WEBHOOK_URL=
# Qdrant production reads/writes should use the stable alias. The alias points
# to the active generation collection and can be switched/rolled back atomically.
MEMORY_XX_QDRANT_BASE_URL=http://127.0.0.1:6333
MEMORY_XX_QDRANT_COLLECTION=memory-xx-active
MEMORY_XX_QDRANT_ALIAS=memory-xx-active

# Local memory embedding generation context. These values must match the active
# row in memory_embedding_generations and Qdrant point payloads.
EMBEDDING_API_BASE=http://127.0.0.1:5221/v1
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_DIMS=4096
MEMORY_XX_EMBEDDING_PROVIDER=local-ovms
MEMORY_XX_EMBEDDING_PRECISION=int4
MEMORY_XX_EMBEDDING_GENERATION_ID=local-qwen8b-int4-v1
MEMORY_XX_EMBEDDING_TEXT_STRATEGY=title_summary_scope_type_layer_content_v1
MEMORY_XX_QUERY_EMBEDDING_CACHE_VERSION=query-embedding-v3-local-qwen8b-int4-memory-v1
# Stable-first cloud proxy defaults for 127.0.0.1:5221:
# EMBEDDING_PROXY_TIMEOUT_MS=5000
# EMBEDDING_PROXY_MAX_RETRIES=0
# EMBEDDING_PROXY_MAX_CONCURRENCY=1
# EMBEDDING_PROXY_MIN_INTERVAL_MS=3000
# EMBEDDING_PROXY_RATE_LIMIT_COOLDOWN_MS=30000
# Local OVMS embedding upstream:
# EMBEDDING_PROXY_UPSTREAM_BASE=http://127.0.0.1:8082/v3
# EMBEDDING_PROXY_MIN_INTERVAL_MS=0
# Required for vector retrieval. Keep this only in the local env file, not in git.
# OPENAI_API_KEY=

# Runtime module switches. Core services stay enabled; enhanced/full services
# stay disabled until their local model/API dependencies are configured.
MEMORY_XX_EMBEDDING_PROXY_ENABLED=1
MEMORY_XX_EMBEDDING_UPSTREAM_ENABLED=1
MEMORY_XX_QDRANT_PROXY_ENABLED=0
MEMORY_XX_FASTPATH_ENABLED=0
MEMORY_XX_LEXICAL_SIDECAR_ENABLED=0
MEMORY_XX_RERANKER_UPSTREAM_ENABLED=0
MEMORY_XX_RERANKER_ADAPTER_ENABLED=0
MEMORY_XX_LLM_UPSTREAM_ENABLED=0
MEMORY_XX_MEM0_EXTRACTOR_ENABLED=0
MEMORY_XX_CONVERSATION_MONITOR_ENABLED=0
MEMORY_XX_MARKDOWN_PROJECTION_ENABLED=0
MEMORY_XX_CONTROL_PANEL_ENABLED=0
MEMORY_XX_CACHE_INVALIDATION_WORKER_ENABLED=0
MEMORY_XX_MAINTENANCE_ENABLED=0
MEMORY_XX_RUNTIME_ISSUE_DETECTION_ENABLED=0
MEMORY_XX_AUTO_REPAIR_ENABLED=0
MEMORY_XX_REPAIR_REPORT_ENABLED=0
MEMORY_XX_LANDING_SCAN_ENABLED=0
MEMORY_XX_CANARY_7D_REPORT_ENABLED=0
MEMORY_XX_QUALITY_RUNNER_ENABLED=0
MEMORY_XX_GOVERNANCE_REPORT_ENABLED=0

# Full-stack capability switches. These CLI-only capability packages are
# disabled by default so a missing local model, external endpoint, or operations
# dependency cannot break Core write/recall. Set a switch to 1 only after the
# matching dependency and runbook are configured.
MEMORY_XX_KNOWLEDGE_INGEST_ENABLED=0
MEMORY_XX_MEMORY_GRAPH_ENABLED=0
MEMORY_XX_CODE_GRAPH_ENABLED=0
MEMORY_XX_TEMPORAL_DECAY_ENABLED=0
MEMORY_XX_CONSOLIDATION_ENABLED=0
MEMORY_XX_DREAMING_ENABLED=0
MEMORY_XX_POLICY_EVAL_ENABLED=0
MEMORY_XX_RECALL_QUALITY_ENABLED=0
MEMORY_XX_AUTO_APPROVAL_ENABLED=0
MEMORY_XX_AUTO_UPDATE_ENABLED=0
MEMORY_XX_EMBEDDING_MANIFEST_ENABLED=0
MEMORY_XX_EMBEDDING_CALIBRATION_ENABLED=0
MEMORY_XX_LOCAL_EMBEDDING_GENERATION_ENABLED=0
MEMORY_XX_BACKUP_ENABLED=0
MEMORY_XX_PLATFORM_DOCTOR_ENABLED=0
MEMORY_XX_TRUSTED_AGENT_TOOLS_ENABLED=0
MEMORY_XX_QDRANT_RECONCILE_ENABLED=0
MEMORY_XX_CONVERSATION_OPS_ENABLED=0
MEMORY_XX_GOVERNANCE_OPS_ENABLED=0
MEMORY_XX_RUNTIME_OBSERVABILITY_RETENTION_ENABLED=0
MEMORY_XX_WRITE_TICKET_MAINTENANCE_ENABLED=0
MEMORY_XX_DEPLOYMENT_PACKAGING_ENABLED=0
MEMORY_XX_RELEASE_GOVERNANCE_GATES_ENABLED=0
MEMORY_XX_SELF_IMPROVEMENT_ENABLED=0
