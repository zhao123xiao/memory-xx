# Memory XX Wrapper Configuration

# Server
MEMORY_XX_WRAPPER_PORT=5100
MEMORY_XX_WRAPPER_MODE=full

# Docker Compose host port overrides. Container-internal ports stay at their
# defaults; change these only to avoid conflicts on the host.
MEMORY_XX_WRAPPER_HOST_PORT=5100
MEMORY_XX_EMBEDDING_PROXY_HOST_PORT=5221
MEMORY_XX_DEV_EMBEDDING_HOST_PORT=5222
MEMORY_XX_FASTPATH_HOST_PORT=5200
MEMORY_XX_LEXICAL_HOST_PORT=5210
MEMORY_XX_QDRANT_PROXY_HOST_PORT=6334
MEMORY_XX_RERANKER_ADAPTER_HOST_PORT=8085
MEMORY_XX_CONTROL_PANEL_HOST_PORT=5310
MEMORY_XX_MEM0_EXTRACTOR_HOST_PORT=5220
MEMORY_XX_POSTGRES_HOST_PORT=5432
MEMORY_XX_REDIS_HOST_PORT=6379
MEMORY_XX_QDRANT_HOST_PORT=6333

# PostgreSQL
MEMORY_XX_DATABASE_URL=postgres://user:pass@localhost:5432/memory_xx
MEMORY_XX_DATABASE_SCHEMA=public
MEMORY_XX_DATABASE_MAX_CONNECTIONS=10
MEMORY_XX_DATABASE_IDLE_TIMEOUT_MS=30000

# Redis
MEMORY_XX_REDIS_URL=redis://localhost:6379/0
MEMORY_XX_CACHE_TTL_SECONDS=300
MEMORY_XX_CACHE_KEY_PREFIX=memory_xx

# Capacity audit thresholds
MEMORY_XX_CAPACITY_MEMORY_RECORDS_THRESHOLD=100000
MEMORY_XX_CAPACITY_OUTBOX_PENDING_THRESHOLD=1000
MEMORY_XX_CAPACITY_WRITE_TICKETS_ACTIVE_THRESHOLD=5000
MEMORY_XX_CAPACITY_QDRANT_POINTS_THRESHOLD=50000
MEMORY_XX_CAPACITY_REDIS_USED_MEMORY_RATIO_THRESHOLD=0.8
MEMORY_XX_CAPACITY_REDIS_CACHE_KEYS_THRESHOLD=10000
MEMORY_XX_CAPACITY_OUTBOX_DEAD_LETTER_THRESHOLD=50
MEMORY_XX_CAPACITY_OUTBOX_DEAD_LETTER_MAX_ATTEMPTS=5

# Qdrant (optional)
MEMORY_XX_QDRANT_BASE_URL=http://localhost:6333
MEMORY_XX_QDRANT_COLLECTION=memory-xx

# OpenAI / Embeddings
OPENAI_API_KEY=<set-in-env>
EMBEDDING_API_BASE=https://embedding-provider.example/v1
EMBEDDING_API_KEY=<set-in-env>

# Embedding model (required)
# Qwen3-Embedding-0.6B max 1024 dims; Qwen3-Embedding-8B supports 4096 dims
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_DIMS=4096

# Reranker (optional, strongly recommended)
MEMORY_XX_RERANKER_ADAPTER_ENABLED=0
MEMORY_XX_RERANKER_ADAPTER_URL=http://127.0.0.1:8085
MEMORY_XX_RERANKER_DOWNSTREAM_URL=http://127.0.0.1:8084/v3/rerank

# Mem0 extractor LLM (optional, for auto-extraction)
MEMORY_XX_MEM0_BASE_URL=https://api.openai.com/v1
MEMORY_XX_MEM0_MODEL=gpt-4o-mini
MEMORY_XX_MEM0_API_KEY=<set-in-env>
MEMORY_XX_MEM0_EXTRACTOR_ENABLED=0

# Intelligence / mem0 extractor
MEMORY_INTELLIGENCE_API_KEY=<set-in-env>
MEMORY_INTELLIGENCE_FALLBACK_API_KEY=<set-in-env>
MEMORY_INTELLIGENCE_MEM0_API_KEY=<set-in-env>
MEMORY_INTELLIGENCE_MEM0_URL=http://127.0.0.1:5220

# Security
MEMORY_XX_API_TOKEN=<set-in-env>
MEMORY_XX_MCP_TOKEN=<set-in-env>
MEMORY_XX_ADMIN_TOKEN=<set-in-env>

# CORS
MEMORY_XX_CORS_ENABLED=true
MEMORY_XX_CORS_ORIGINS=

# Rate Limiting
MEMORY_XX_RATE_LIMIT_MAX=60
MEMORY_XX_RATE_LIMIT_WINDOW_MS=60000

# Logging
MEMORY_XX_LOG_LEVEL=info
