# Local env file for the qdrant projector worker systemd user service.
# Copy to ~/.config/memory-xx/memory-xx-qdrant-projector-worker.env and fill real values.

MEMORY_XX_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/memory_xx
MEMORY_XX_DATABASE_SCHEMA=memory_xx
MEMORY_XX_QDRANT_BASE_URL=http://127.0.0.1:6333
MEMORY_XX_QDRANT_COLLECTION=memory-xx
# Optional if your Qdrant requires auth.
# MEMORY_XX_QDRANT_API_KEY=

MEMORY_XX_QDRANT_PROJECTOR_EXPORTER_NAME=qdrant_projector
MEMORY_XX_QDRANT_PROJECTOR_INTERVAL_MS=5000
MEMORY_XX_QDRANT_PROJECTOR_BATCH_SIZE=50
MEMORY_XX_QDRANT_PROJECTOR_MAX_ATTEMPTS=5
MEMORY_XX_QDRANT_PROJECTOR_RETRY_DELAY_MS=5000
MEMORY_XX_QDRANT_PROJECTOR_IDLE_LOG_EVERY=12
MEMORY_XX_QDRANT_PROJECTOR_ONCE=false
MEMORY_XX_QDRANT_PROJECTOR_STATUS_FILE=<project-root>/qdrant-projector-worker.status.json
