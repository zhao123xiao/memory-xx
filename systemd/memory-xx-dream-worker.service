[Unit]
Description=memory-xx dream worker
After=network-online.target memory-xx-wrapper.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/services/memory-xx
EnvironmentFile=%h/services/memory-xx/.env
Environment=MEMORY_XX_ENV_PATH=%h/services/memory-xx/.env
Environment=TMPDIR=/tmp
ExecCondition=/usr/bin/node --import tsx scripts/runtime-module-enabled.ts memory_dreaming
ExecStart=/usr/bin/node --import tsx %h/services/memory-xx/scripts/run-dream-worker.ts
Restart=always
RestartSec=30
StandardOutput=append:%h/services/memory-xx/.runtime/dream-worker.log
StandardError=append:%h/services/memory-xx/.runtime/dream-worker.error.log

[Install]
WantedBy=memory-xx.target
