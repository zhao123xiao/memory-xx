[Unit]
Description=Build memory-xx 7-day production canary report
After=network-online.target memory-xx-landing-scan.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/services/memory-xx
EnvironmentFile=%h/services/memory-xx/.env
Environment=MEMORY_XX_ENV_PATH=%h/services/memory-xx/.env
Environment=TMPDIR=/tmp
Environment=MEMORY_XX_RUNTIME_DIR=%h/services/memory-xx/.runtime
ExecCondition=/usr/bin/node --import tsx scripts/runtime-module-enabled.ts canary_7d_report
ExecStart=/usr/bin/npm run memory:canary-7d-report -- --json --write-report
StandardOutput=append:%h/services/memory-xx/.runtime/canary-7d-report.log
StandardError=append:%h/services/memory-xx/.runtime/canary-7d-report.error.log
