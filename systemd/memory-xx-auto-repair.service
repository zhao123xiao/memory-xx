[Unit]
Description=memory-xx safe automatic repair
After=network-online.target memory-xx-wrapper.service memory-xx-qdrant-projector-worker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/services/memory-xx
EnvironmentFile=%h/services/memory-xx/.env
Environment=MEMORY_XX_ENV_PATH=%h/services/memory-xx/.env
Environment=TMPDIR=/tmp
ExecStart=/usr/bin/npm run memory:auto-repair -- --apply --json
StandardOutput=append:%h/services/memory-xx/repair.log
StandardError=append:%h/services/memory-xx/repair.error.log
