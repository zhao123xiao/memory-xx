[Unit]
Description=OpenClaw memory-xx wrapper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/services/memory-xx
EnvironmentFile=%h/services/memory-xx/.env
Environment=MEMORY_V2_ENV_PATH=%h/services/memory-xx/.env
Environment=NODE_ENV=production
Environment=EMBEDDING_API_BASE=http://127.0.0.1:5221/v1
ExecStart=/usr/local/bin/node %h/services/memory-xx/wrapper-entry.mjs
Restart=always
RestartSec=5
StandardOutput=append:%h/services/memory-xx/wrapper.log
StandardError=append:%h/services/memory-xx/wrapper.error.log

[Install]
WantedBy=default.target
