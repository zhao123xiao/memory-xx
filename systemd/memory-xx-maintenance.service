[Unit]
Description=memory-xx unified maintenance orchestrator
After=network-online.target memory-xx-wrapper.service memory-xx-qdrant-projector-worker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/services/memory-xx
EnvironmentFile=%h/services/memory-xx/.env
Environment=MEMORY_XX_ENV_PATH=%h/services/memory-xx/.env
Environment=TMPDIR=/tmp
ExecCondition=/usr/bin/node --import tsx scripts/runtime-module-enabled.ts maintenance_orchestrator
ExecStart=/usr/bin/node --import tsx %h/services/memory-xx/scripts/maintenance.ts run --mode auto --json
StandardOutput=append:%h/services/memory-xx/maintenance.log
StandardError=append:%h/services/memory-xx/maintenance.error.log
