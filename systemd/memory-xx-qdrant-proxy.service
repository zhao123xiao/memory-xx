[Unit]
Description=memory-xx Qdrant collection proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/services/memory-xx
EnvironmentFile=-%h/services/memory-xx/.env
Environment=MEMORY_XX_QDRANT_PROXY_HOST=127.0.0.1
Environment=MEMORY_XX_QDRANT_PROXY_PORT=6335
Environment=MEMORY_XX_QDRANT_PROXY_UPSTREAM=http://127.0.0.1:6333
Environment=MEMORY_XX_QDRANT_PROXY_FROM_COLLECTION=memory-xx
Environment=MEMORY_XX_QDRANT_PROXY_TO_COLLECTION=memory-xx-active
Environment=MEMORY_XX_QDRANT_PROXY_TIMEOUT_MS=30000
ExecCondition=/usr/bin/node --import tsx scripts/runtime-module-enabled.ts qdrant_proxy
ExecStart=/usr/bin/node %h/services/memory-xx/sidecars/qdrant-proxy/qdrant-collection-proxy.mjs
Restart=always
RestartSec=3
StandardOutput=append:%h/services/memory-xx/.runtime/qdrant-proxy.log
StandardError=append:%h/services/memory-xx/.runtime/qdrant-proxy.error.log

[Install]
WantedBy=memory-xx.target
