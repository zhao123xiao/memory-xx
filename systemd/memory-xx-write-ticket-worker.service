[Unit]
Description=memory-xx write ticket worker
After=network-online.target memory-xx-wrapper.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/services/memory-xx
EnvironmentFile=%h/services/memory-xx/.env
Environment=MEMORY_XX_ENV_PATH=%h/services/memory-xx/.env
Environment=TMPDIR=/tmp
Environment=MEMORY_XX_RUNTIME_DIR=%h/services/memory-xx/.runtime
Environment=MEMORY_XX_WRITE_TICKET_WORKER_STATUS_FILE=%h/services/memory-xx/.runtime/write-ticket-worker.status.json
ExecCondition=/usr/bin/node --import tsx scripts/runtime-module-enabled.ts write_ticket_worker
ExecStart=/usr/bin/node --import tsx %h/services/memory-xx/scripts/run-write-ticket-worker.ts
Restart=always
RestartSec=5
StandardOutput=append:%h/services/memory-xx/.runtime/write-ticket-worker.log
StandardError=append:%h/services/memory-xx/.runtime/write-ticket-worker.error.log

[Install]
WantedBy=memory-xx.target
