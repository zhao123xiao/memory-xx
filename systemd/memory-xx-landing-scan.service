[Unit]
Description=Run memory-xx production landing scan snapshot
After=memory-xx-wrapper.service

[Service]
Type=oneshot
WorkingDirectory=<project-root>
Environment=TMPDIR=/tmp
ExecCondition=/usr/bin/node --import tsx scripts/runtime-module-enabled.ts landing_scan
ExecStart=/usr/bin/env npm run memory:landing-scan -- --json --write-report --max-files=200
