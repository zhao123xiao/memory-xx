[Unit]
Description=memory-xx markdown projection worker
After=network-online.target memory-xx-wrapper.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/services/memory-xx
EnvironmentFile=%h/services/memory-xx/.env
Environment=MEMORY_XX_ENV_PATH=%h/services/memory-xx/.env
Environment=TMPDIR=/tmp
Environment=MEMORY_XX_RUNTIME_DIR=%h/services/memory-xx/.runtime
Environment=MEMORY_XX_MARKDOWN_PROJECTION_STATUS_FILE=%h/services/memory-xx/.runtime/markdown-projection.status.json
ExecCondition=/usr/bin/node --import tsx scripts/runtime-module-enabled.ts markdown_projection
ExecStart=/usr/bin/node --import tsx %h/services/memory-xx/scripts/run-markdown-projection-worker.ts
StandardOutput=append:%h/services/memory-xx/.runtime/markdown-projection.log
StandardError=append:%h/services/memory-xx/.runtime/markdown-projection.error.log

[Install]
WantedBy=memory-xx.target
