[Unit]
Description=memory-xx lexical sidecar
After=network-online.target memory-xx-wrapper.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/services/memory-xx
EnvironmentFile=%h/services/memory-xx/.env
Environment=MEMORY_XX_LEXICAL_ADDR=127.0.0.1:5210
Environment=MEMORY_XX_LEXICAL_DEFAULT_LIMIT=50
Environment=MEMORY_XX_LEXICAL_MAX_LIMIT=100
ExecStart=/usr/bin/node %h/services/memory-xx/sidecars/lexical-sidecar/lexical-sidecar.mjs
Restart=always
RestartSec=3
StandardOutput=append:%h/services/memory-xx/.runtime/lexical-sidecar.log
StandardError=append:%h/services/memory-xx/.runtime/lexical-sidecar.error.log

[Install]
WantedBy=memory-xx.target
